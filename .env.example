# ---------------------------------------------------------------------------
# TwinPM configuration. Copy to `.env` (repo root for docker compose, and
# apps/api/.env for local `make dev`). Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime environment: dev | test | prod
ENV=dev
LOG_LEVEL=INFO
# JSON logs (true) or pretty console logs (false)
LOG_JSON=true

# Postgres 16 with pgvector, and Redis 7
DATABASE_URL=postgresql+asyncpg://twinpm:twinpm@localhost:5432/twinpm
REDIS_URL=redis://localhost:6379/0

# Auth. JWT_SECRET must be a long random string in prod (openssl rand -hex 32).
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
# true behind HTTPS so auth cookies get the Secure flag
COOKIE_SECURE=false
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3100"]
# Fernet key that encrypts integration secrets at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Anthropic. Leave the key empty to run fully offline in demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-5-5
# Force deterministic demo responses even when a key is set
DEMO_MODE=false
# Mock connectors emit small realistic changes on each sync
DEMO_LIVE_TICKS=true
LLM_MAX_OUTPUT_TOKENS=2048

# Password for every seeded demo user
SEED_DEMO_PASSWORD=TwinPM-demo-2026!

# Model registry location (relative to apps/api when running locally)
MODELS_DIR=models

# Optional OpenTelemetry collector (e.g. http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional LangSmith tracing for LangGraph runs
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Per-user rate limits
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# Host ports for docker compose
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3100
